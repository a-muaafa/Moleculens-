# ============================================================================
# MolecuLens — Example Environment Configuration (.env.example)
# Copy this file to .env if you want to override default runtime settings.
# IMPORTANT: Never commit real API keys, passwords, or secrets to Git.
# MolecuLens uses public, unauthenticated scientific REST APIs (PubChem, ChEMBL,
# UniProt, PDB, Rhea, ChEBI) and a full offline local SQLite database.
# ============================================================================

# Application environment: development | testing | production
MOLECULENS_ENV=development

# External scientific API network settings
ALLOW_EXTERNAL_NETWORK=true
EXTERNAL_API_TIMEOUT_SECONDS=5
EXTERNAL_API_MAX_RETRIES=2
NETWORK_DEBOUNCE_SECONDS=2.0

# In-memory & optional disk cache configuration
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=512

# Relative path to local SQLite database (resolved relative to project root)
MOLECULENS_SQLITE_REL_PATH=data/moleculens_local.db
